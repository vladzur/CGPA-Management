# Valores para desarrollo local con Firebase Emulators
# En producción, estas variables se inyectan desde GitHub Secrets

# ─── Firebase ───────────────────────────────────────────────────────────────
FIREBASE_STORAGE_BUCKET="cgpa-liceo-agb.firebasestorage.app"

# ─── MVI — Document Integrity Verification ──────────────────────────────────
# Salt secreta usada para el hash SHA-256 del sellado de documentos.
# Debe ser una cadena larga, aleatoria y mantenerse en secreto.
DOCUMENT_SALT="cambiar-por-salt-segura-de-al-menos-32-caracteres"

# URL base pública para los enlaces de verificación QR.
# En producción: https://cgpagrahambell.cl
VERIFICATION_BASE_URL="http://localhost:5173"

# ─── Libro de Balance ───────────────────────────────────────────────────────
# RUT por defecto del emisor en los PDF del libro de balance.
CGPA_RUT="XX.XXX.XXX-X"

# ─── Botón de pago ──────────────────────────────────────────────────────────
# URL pública de la API. De ella se deriva el webhook de cada pasarela
# (<PUBLIC_API_URL>/pagos/<proveedor>/webhook). En local debe apuntar a un túnel
# accesible desde internet (por ejemplo ngrok), no a localhost.
# Si se omite, se usa VERIFICATION_BASE_URL + /api.
PUBLIC_API_URL="http://localhost:3000/api"

# URL base del frontend usada en return_url y cancel_url.
# Si se omite, se usa VERIFICATION_BASE_URL.
CLIENT_BASE_URL="http://localhost:5173"

# Días de vigencia de cada cobro.
PAGO_TTL_DIAS="7"

# ─── Khipu (pasarela) ───────────────────────────────────────────────────────
# Clave entregada por el portal de desarrolladores de Khipu. Sin ella el
# endpoint /pagos/khipu responde 503 y el sitio muestra un error al apoderado.
KHIPU_API_KEY=""

# Base de la API v3. En producción se usa la misma URL con credenciales reales.
KHIPU_API_BASE_URL="https://khipu.com/api/v3"
