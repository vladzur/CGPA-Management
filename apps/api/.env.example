# Valores para desarrollo local con Firebase Emulators
# En producción, estas variables se inyectan desde GitHub Secrets

# ─── Firebase ───────────────────────────────────────────────────────────────
FIREBASE_STORAGE_BUCKET="cgpa-liceo-agb.firebasestorage.app"

# ─── MVI — Document Integrity Verification ──────────────────────────────────
# Salt secreta usada para el hash SHA-256 del sellado de documentos.
# Debe ser una cadena larga, aleatoria y mantenerse en secreto.
DOCUMENT_SALT="cambiar-por-salt-segura-de-al-menos-32-caracteres"

# URL base pública para los enlaces de verificación QR.
# En producción: https://cgpa-liceo-agb.web.app
VERIFICATION_BASE_URL="http://localhost:5173"

# ─── Libro de Balance ───────────────────────────────────────────────────────
# RUT por defecto del emisor en los PDF del libro de balance.
CGPA_RUT="XX.XXX.XXX-X"
